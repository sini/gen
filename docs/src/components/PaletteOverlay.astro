---
/*
 * The palette overlay: markup, its driving script, and its styles.
 *
 * This deliberately does NOT live in the ThemeProvider override. Starlight
 * renders ThemeProvider inside <head> (Page.astro), where the default
 * implementation is only a script and a <template> — both legal there. Emitting
 * a <div> from it implicitly closes <head> at that point, which pushed the main
 * stylesheet link into <body>, where it no longer blocks the first paint. The
 * result was a visible flash of unstyled header on every navigation.
 *
 * Rendered from Footer.astro instead, which appears exactly once per page on
 * both the splash and doc templates.
 */
import { inlineScript, palettes } from '../palettes.mjs';

const groups = [
  { mode: 'dark', items: palettes.filter((p) => p.mode === 'dark') },
  { mode: 'light', items: palettes.filter((p) => p.mode === 'light') },
];

/*
 * A native <dialog> opened with showModal(), so the focus trap, the Escape
 * handling and the focus restore on close are the platform's rather than three
 * more things to keep correct here. Resolving, reading and writing the
 * preference all go through `window.__palette`, published by the head boot
 * script — there is one definition of which palette is active.
 */
const script = inlineScript(`(function(){
var P=window.__palette;
var overlay=document.getElementById("palette-overlay");
var list=document.getElementById("palette-list");
if(!P||!overlay||!list)return;
var options=Array.prototype.slice.call(list.querySelectorAll("[role='option']"));
var media=matchMedia("(prefers-color-scheme: light)");
var committed=P.active();

function sync(id){
  options.forEach(function(o){o.setAttribute("aria-selected",String(o.dataset.value===id))});
  var hit=options.find(function(o){return o.dataset.value===id});
  if(hit)Array.prototype.forEach.call(document.querySelectorAll(".palette-label"),function(el){
    el.textContent=hit.textContent.trim()});
}
function preview(i){
  if(i<0||i>=options.length)return;
  var id=options[i].dataset.value;P.apply(id);sync(id);options[i].focus();
}
// Every close path settles on a palette first, so the page is never left
// showing a preview that was never stored.
function closeWith(id){P.apply(id);sync(id);overlay.close()}
function commit(id){P.write(id);committed=id;closeWith(id)}
function revert(){closeWith(committed)}
function open(){
  committed=P.active();
  overlay.showModal();document.body.style.overflow="hidden";sync(committed);
  var sel=list.querySelector("[aria-selected='true']")||options[0];
  if(sel)sel.focus();
}
function toggle(){overlay.open?revert():open()}

// Escape reaches the dialog as 'cancel'; the browser closes it either way, so
// this only has to undo the preview.
overlay.addEventListener("cancel",function(){P.apply(committed);sync(committed)});
overlay.addEventListener("close",function(){document.body.style.overflow=""});
overlay.addEventListener("click",function(e){if(e.target===overlay)revert()});

media.addEventListener("change",function(){
  if(P.read())return;
  committed=P.fallback();P.apply(committed);sync(committed);
});
options.forEach(function(o,i){
  o.addEventListener("click",function(){commit(o.dataset.value)});
  o.addEventListener("mouseenter",function(){preview(i)});
});
document.addEventListener("keydown",function(e){
  if((e.key==="t"||e.key==="/")&&!e.ctrlKey&&!e.metaKey&&!e.altKey){
    var el=document.activeElement,t=el&&el.tagName;
    if(t==="INPUT"||t==="TEXTAREA"||t==="SELECT"||(el&&el.isContentEditable))return;
    e.preventDefault();toggle();return;
  }
  if(!overlay.open)return;
  var i=options.indexOf(document.activeElement);
  if(e.key==="ArrowDown"){e.preventDefault();preview(i>=0?Math.min(options.length-1,i+1):0)}
  else if(e.key==="ArrowUp"){e.preventDefault();preview(i>=0?Math.max(0,i-1):options.length-1)}
  else if(e.key==="Enter"&&i>=0){e.preventDefault();commit(options[i].dataset.value)}
});
document.addEventListener("click",function(e){
  if(e.target.closest&&e.target.closest(".palette-trigger")){e.preventDefault();toggle()}
});
// The trigger labels live in the header and mobile menu, which render after
// this script, so the first sync waits for them.
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",function(){sync(committed)});
else sync(committed);
})();`);
---

<dialog class="palette-overlay" id="palette-overlay" aria-label="Palette switcher">
  <div class="panel">
    <div class="title">palette</div>
    <div class="list" id="palette-list" role="listbox" aria-label="Palettes">
      {
        groups.map((g) => (
          <>
            <div class="sep"><span>{g.mode}</span></div>
            {g.items.map((p) => (
              <button type="button" role="option" data-value={p.id}>{p.label}</button>
            ))}
          </>
        ))
      }
    </div>
    <div class="foot">
      <span><kbd>↑↓</kbd> select</span>
      <span><kbd>↵</kbd> apply <kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

{/* Must follow the markup above: the script resolves its elements synchronously. */}
<script is:inline set:html={script}></script>

<style>
  /* Undo the UA's centred, auto-sized, bordered box: the dialog is the full
     viewport and the visible surface is `.panel` inside it, so a click landing
     on the dialog itself is unambiguously a click outside the panel. */
  .palette-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .palette-overlay:not([open]) {
    display: none;
  }

  /* The backdrop sits in the top layer, so it is styled from the palette
     variables `paletteCss()` puts on `[data-palette] ::backdrop` rather than
     from a token it may not inherit. */
  .palette-overlay::backdrop {
    background: color-mix(in srgb, var(--sl-color-black) 66%, transparent);
    backdrop-filter: blur(2px);
  }

  .panel {
    width: min(22rem, 92vw);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 4px;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-lg);
    font-family: var(--sl-font-mono, var(--__sl-font-mono));
    font-size: var(--sl-text-sm);
    overflow: hidden;
  }

  .title {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-white);
  }

  .list {
    max-height: min(24rem, 60vh);
    overflow-y: auto;
    padding: 0.25rem 0;
  }

  .sep {
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .list button {
    display: block;
    width: 100%;
    padding: 0.3rem 0.75rem 0.3rem 1.5rem;
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
    position: relative;
  }

  .list button:hover,
  .list button:focus-visible {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    outline: none;
  }

  .list button[aria-selected='true']::before {
    content: '>';
    position: absolute;
    inset-inline-start: 0.6rem;
    color: var(--sl-color-accent);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.75rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-2xs);
  }

  kbd {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 2px;
    padding: 0 0.25rem;
    color: var(--sl-color-gray-2);
  }
</style>
